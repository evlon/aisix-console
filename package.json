{
  "name": "aisix-console",
  "version": "0.2.5",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": ["server", "web"],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev -w server\" \"npm:dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "test": "npm test -w server && npm test -w web",
    "smoke": "node scripts/smoke-routes.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
